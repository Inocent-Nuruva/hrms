# Example environment variables for the HRMS frontend
# Copy this file to .env and update values for your local environment.

# Next.js sets this automatically (development/production) — only override for
# special cases like CI. Do not rely on this being "production" to gate secrets.
NODE_ENV=development

# Branding shown in the browser tab / metadata.
NEXT_PUBLIC_APP_NAME=HRMSS

# Backend API this app talks to.
# Use /api behind nginx so the same build works from public and private URLs.
# Local development can still use http://localhost:9999.
NEXT_PUBLIC_API_BASE_URL=/api
NEXT_PUBLIC_USE_MOCK_AUTH=false

# Third-party countries/states/cities lookup API used by src/app/api/public-locations.
COUNTRIES_API_BASE_URL=https://countriesnow.space/api/v0.1

# Timing / polling tuning (all in milliseconds). Defaults are sane for most
# environments — override only if a deployment needs different responsiveness.
NEXT_PUBLIC_MOCK_AUTH_DELAY_MS=1500
NEXT_PUBLIC_SESSION_CHECK_INTERVAL_MS=30000
NEXT_PUBLIC_TOKEN_REFRESH_WINDOW_MS=60000
NEXT_PUBLIC_NOTIFICATION_POLL_INTERVAL_MS=60000
NEXT_PUBLIC_LIST_CACHE_TTL_SHORT_MS=20000
NEXT_PUBLIC_LIST_CACHE_TTL_LONG_MS=60000
NEXT_PUBLIC_DEVICE_ACTION_TIMEOUT_MS=20000
NEXT_PUBLIC_DEVICE_BULK_ACTION_TIMEOUT_MS=90000

# Pagination
NEXT_PUBLIC_MAX_PAGE_SIZE=100
