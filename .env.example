# Example environment variables for the HRMS frontend
# Copy this file to .env and update values for your local environment.

# Next.js sets this automatically (development/production) — only override for
# special cases like CI. Do not rely on this being "production" to gate secrets.
NODE_ENV=development

# Branding shown in the browser tab / metadata.
NEXT_PUBLIC_APP_NAME=HRMSS
# Build-time KPI navigation and pages switch; pair with backend KPI_ENABLED.
NEXT_PUBLIC_KPI_ENABLED=true

# Backend API this app talks to.
NEXT_PUBLIC_API_BASE_URL=http://192.168.1.30:9999
# Optional; leave blank to prevent attendance coordinates from generating map tile requests.
# Configure an organization-approved HTTPS tile service and its required attribution only after privacy review.
NEXT_PUBLIC_ATTENDANCE_MAP_TILE_URL=
NEXT_PUBLIC_ATTENDANCE_MAP_TILE_ATTRIBUTION=
# Optional: Next.js rewrite target when NEXT_PUBLIC_API_BASE_URL is /api.
# Hosted: UAT NEXT_PUBLIC_API_BASE_URL=http://196.41.62.162:9999 (BACKEND_ORIGIN 127.0.0.1:9999);
# Production NEXT_PUBLIC_API_BASE_URL=https://hrms.alliance.co.tz (BACKEND_ORIGIN 127.0.0.1:8888).
# BACKEND_ORIGIN=http://127.0.0.1:8888
NEXT_PUBLIC_USE_MOCK_AUTH=false

# Third-party countries/states/cities lookup API used by src/app/api/public-locations.
COUNTRIES_API_BASE_URL=https://countriesnow.space/api/v0.1

# Timing / polling tuning (all in milliseconds). Defaults are sane for most
# environments — override only if a deployment needs different responsiveness.
NEXT_PUBLIC_MOCK_AUTH_DELAY_MS=1500
NEXT_PUBLIC_SESSION_CHECK_INTERVAL_MS=30000
NEXT_PUBLIC_TOKEN_REFRESH_WINDOW_MS=60000
NEXT_PUBLIC_NOTIFICATION_POLL_INTERVAL_MS=60000
NEXT_PUBLIC_LIST_CACHE_TTL_SHORT_MS=20000
NEXT_PUBLIC_LIST_CACHE_TTL_LONG_MS=60000
NEXT_PUBLIC_DEVICE_ACTION_TIMEOUT_MS=20000
NEXT_PUBLIC_DEVICE_BULK_ACTION_TIMEOUT_MS=90000

# Pagination
NEXT_PUBLIC_MAX_PAGE_SIZE=100

# Playwright e2e test users. These must exist in the backend database and must
# not require 2FA during automated test runs.
HRMS_E2E_ADMIN_EMAIL=admin@example.com
HRMS_E2E_ADMIN_PASSWORD=replace-with-admin-password
HRMS_E2E_HR_EMAIL=hr@example.com
HRMS_E2E_HR_PASSWORD=replace-with-hr-password
PLAYWRIGHT_BASE_URL=http://localhost:3000

# Shared atomic quotas for support chat and authenticated photo uploads.
# Production fails closed if either setting is absent or Redis is unavailable.
# Use a Redis REST service supporting EVAL (for example, Upstash Redis REST).
RATE_LIMIT_REDIS_REST_URL=
RATE_LIMIT_REDIS_REST_TOKEN=
# Optional public caller identity. Set only when a trusted ingress strips and
# replaces this header; otherwise anonymous clients deliberately share a quota.
RATE_LIMIT_TRUSTED_IP_HEADER=

# Server-only support escalation and application upload rewrite target.
# Set to the actual backend origin. Escalation defaults to http://127.0.0.1:4000.
# INTERNAL_BACKEND_URL=http://127.0.0.1:4000
