{
  "name": "hrms",
  "version": "0.1.0",
  "private": true,
  "main": "desktop/main.cjs",
  "scripts": {
    "dev": "next dev",
    "desktop": "electron .",
    "desktop:build": "npm run desktop:package",
    "desktop:package": "npm run build && electron-builder --dir",
    "desktop:installer": "npm run build && electron-builder",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run"
  },
  "dependencies": {
    "@base-ui-components/react": "^1.0.0-rc.0",
    "@base-ui/react": "^1.4.1",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@heroui/react": "^3.1.0",
    "@heroui/styles": "^3.1.0",
    "@hookform/resolvers": "^5.2.2",
    "@radix-ui/react-slot": "^1.2.4",
    "@tanstack/react-table": "^8.21.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "country-flag-icons": "^1.6.17",
    "date-holidays": "^3.32.0",
    "framer-motion": "^12.42.0",
    "libphonenumber-js": "^1.13.1",
    "lucide-react": "^1.14.0",
    "motion": "^12.38.0",
    "next": "16.2.4",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.4.3",
    "react": "19.2.4",
    "react-day-picker": "^9.14.0",
    "react-dom": "19.2.4",
    "react-flags-select": "^2.5.0",
    "react-hook-form": "^7.75.0",
    "react-resizable": "^4.0.2",
    "recharts": "^3.8.0",
    "rg": "^0.0.2",
    "shadcn": "^4.7.0",
    "socket.io-client": "^4.8.3",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
    "vaul": "^1.1.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "electron": "^37.2.0",
    "electron-builder": "^26.0.12",
    "eslint": "^9",
    "eslint-config-next": "16.2.4",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.10"
  },
  "build": {
    "appId": "com.hrms.desktop",
    "productName": "HRMS",
    "asar": false,
    "icon": "desktop/icon.ico",
    "directories": {
      "output": "dist-desktop"
    },
    "files": [
      ".next/**",
      "!.next/cache/**",
      "!.next/dev/**",
      "!.next/diagnostics/**",
      "desktop/**",
      "node_modules/**",
      "package.json",
      "public/**",
      "next.config.ts"
    ],
    "win": {
      "icon": "desktop/icon.ico",
      "target": [
        "nsis",
        "portable"
      ]
    }
  }
}
