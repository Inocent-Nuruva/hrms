{
  "name": "hrms",
  "version": "0.1.0",
  "private": true,
  "main": "desktop/main.cjs",
  "scripts": {
    "dev": "NODE_OPTIONS=--max-old-space-size=4096 NEXT_WEBPACK_PARALLELISM=1 next dev --webpack --disable-source-maps",
    "dev:turbo": "NODE_OPTIONS=--max-old-space-size=2048 next dev --turbopack --disable-source-maps",
    "dev:webpack": "NODE_OPTIONS=--max-old-space-size=4096 NEXT_WEBPACK_PARALLELISM=1 next dev --webpack --disable-source-maps",
    "desktop": "electron .",
    "desktop:build": "npm run desktop:package",
    "desktop:package": "npm run build && electron-builder --dir",
    "desktop:installer": "npm run build && electron-builder",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "@base-ui/react": "^1.4.1",
    "@fluentui/react-components": "^9.74.9",
    "@fluentui/react-datepicker-compat": "^0.6.39",
    "@fluentui/react-icons": "^2.0.343",
    "@fluentui/react-timepicker-compat": "^0.4.41",
    "@heroui/react": "^3.1.0",
    "@heroui/styles": "^3.1.0",
    "@radix-ui/react-slot": "^1.2.4",
    "busboy": "^1.6.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "country-flag-icons": "^1.6.17",
    "date-holidays": "^3.32.0",
    "framer-motion": "^12.42.0",
    "leaflet": "^1.9.4",
    "libphonenumber-js": "^1.13.1",
    "lucide-react": "^1.14.0",
    "motion": "^12.38.0",
    "next": "16.2.4",
    "radix-ui": "^1.4.3",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-flags-select": "^2.5.0",
    "react-hook-form": "^7.75.0",
    "react-leaflet": "^5.0.0",
    "react-resizable": "^4.0.2",
    "recharts": "^3.8.0",
    "server-only": "^0.0.1",
    "shadcn": "^4.7.0",
    "sharp": "^0.35.5",
    "socket.io-client": "^4.8.3",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
    "vaul": "^1.1.2",
    "zod": "^4.4.3"
  },
  "overrides": {
    "keyborg": "3.498.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/busboy": "^1.5.5",
    "@types/jsdom": "^30.0.0",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "electron": "^37.2.0",
    "electron-builder": "^26.0.12",
    "eslint": "^9",
    "eslint-config-next": "16.2.4",
    "jsdom": "^30.1.2",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.10"
  },
  "build": {
    "appId": "com.hrms.desktop",
    "productName": "HRMS",
    "asar": false,
    "icon": "desktop/icon.ico",
    "directories": {
      "output": "dist-desktop"
    },
    "files": [
      ".next/**",
      "!.next/cache/**",
      "!.next/dev/**",
      "!.next/diagnostics/**",
      "desktop/**",
      "node_modules/**",
      "package.json",
      "public/**",
      "next.config.ts"
    ],
    "win": {
      "icon": "desktop/icon.ico",
      "target": [
        "nsis",
        "portable"
      ]
    }
  }
}
